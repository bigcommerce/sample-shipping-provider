{
    "name": "bigcommerce/sample-shipping-provider",
    "description": "Symfony based reference implementation of a Shipping Carrier Service integration",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/asset": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/console": "^8.0",
        "symfony/config": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "autoload": {
        "files": [
            "src/constants.php"
        ],
        "psr-4": {
            "BCSample\\Shipping\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "run": [
            "echo 'Started web server on http://localhost:8888'",
            "php -S localhost:8888 -t public public/index.php"
        ],
        "devrun": [
            "echo 'Started debugging web server on http://localhost:8888'",
            "rm -rf var/cache",
            "php -dxdebug.remote_autostart=1 -dxdebug.remote_enable=1 -dxdebug.remote_port=9000 -S localhost:8888 -t public public/index.php"
        ]
    }
}
